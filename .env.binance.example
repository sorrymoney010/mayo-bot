# ===== Binance.us live bot: copy to `.env` ON YOUR SERVER, then fill the two KEY lines. =====
# Never commit .env (it is gitignored). Never paste keys into chat.
# Binance.us -> API Management: enable Read + Spot trading, DISABLE withdrawals, restrict to your server IP.

BROKER=binance
BINANCE_API_KEY=PASTE_KEY_HERE
BINANCE_API_SECRET=PASTE_SECRET_HERE
# BINANCE_HOST=binance.us            # default; "binance.com" only if you are not US-based

# --- strategy / sizing (first live run) ---
SYMBOL=BTC/USD
STRATEGY=regime_trend
TIMEFRAME_MINUTES=60
STRATEGY_EQUITY_USD=25
RISK_PER_TRADE=0.01
MAX_POSITION_FRACTION=0.25
MAX_LEVERAGE=1.0
MARGIN_EXPOSURE_FRACTION=0
MAX_ORDERS_PER_DAY=3

# --- order style: Binance has no brackets; protection is an exchange-side OCO placed after entry ---
USE_BRACKET=false
ORDER_TYPE=market
BINANCE_EXCHANGE_STOP=true
STOP_LOSS_PCT=0.04
TAKE_PROFIT_PCT=0.08

# --- ledger owner: NOT read from this file. Before running the bot or golive-check in a terminal, run:
#       export MAYO_LEDGER_OWNER=1

# ===== SAFETY LOCKS: leave exactly as-is until `golive-check` has no FAIL and the dry-run looks right. =====
PAPER_TRADING=true
DRY_RUN=true
ALLOW_LIVE_TRADING=false
LIVE_RISK_ACKNOWLEDGEMENT=

# ===== TO GO LIVE (your decision, all four together), then run `golive-check` again: =====
# PAPER_TRADING=false
# DRY_RUN=false
# ALLOW_LIVE_TRADING=true
# LIVE_RISK_ACKNOWLEDGEMENT=I_ACCEPT_LIVE_TRADING_RISK
