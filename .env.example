# MAYO regular-spot regime-trend research profile (BTC/ETH/SOL only).
# This is PAPER/DRY-RUN ONLY. It does not enable live order submission.
BROKER=kraken
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
PAPER_TRADING=true
DRY_RUN=true
ALLOW_LIVE_TRADING=false
LIVE_RISK_ACKNOWLEDGEMENT=
ALLOW_FUTURES_LIVE_ORDERS=false
ALLOW_MARGIN_LIVE_ORDERS=false
PAPER_BLOCK_PRIVATE_API=true
PAPER_USE_LEDGER_EQUITY=true
AUTO_START_MONITOR=false

STRATEGY=regime_trend
ALLOW_RETIRED_STRATEGIES=false
TIMEFRAME_MINUTES=60
SYMBOL=BTC/USD
UNIVERSE_MODE=basket
COIN_BASKET=["BTC/USD","ETH/USD","SOL/USD"]
UNIVERSE_ALLOWLIST=["BTC/USD","ETH/USD","SOL/USD"]
RAPID_MODE=false
DAY_TRADE_MODE=false
LOOKBACK_BARS=500
MONITOR_INTERVAL_SECONDS=300

# Paper-only cost model; validate current venue fees before research conclusions.
STRATEGY_EQUITY_USD=500
RISK_PER_TRADE=0.01
MAX_POSITION_FRACTION=0.25
MAX_DAILY_LOSS_FRACTION=0.03
MAX_DRAWDOWN_FRACTION=0.10
MAX_ORDERS_PER_DAY=3
MAX_CONCURRENT_POSITIONS=3
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.25
REGIME_LOOKBACK=20
REGIME_ATR_MULT=3.0
REGIME_MIN_ATR_RANK=0.0
REGIME_DAILY_FILTER=true

# Retain research modules, but run one strategy in the paper ledger.
MEANREV_SLEEVE_ENABLED=false
TRENDHOLD_SLEEVE_ENABLED=false
FUTURES_SLEEVE_ENABLED=false
LEARNER_GATE_ENABLED=true
LEARNER_MIN_SAMPLE=30
LEARNER_PATH=logs/regime_trend_v1_learner.json
LEARNER_PRIORS_PATH=data/regime_trend_v1_priors.json
PAPER_TAKER_FEE_BPS=40
PAPER_MAKER_FEE_BPS=25
PAPER_SLIPPAGE_BPS=10
PIPELINE_ENABLED=false

# Data collector requires no secrets. See scripts/collect_regime_data.sh.
# NEVER grant withdrawal permissions to a broker key.
