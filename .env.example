# ── Broker selection ───────────────────────────────────────
BROKER=kraken

# ── Kraken Spot (start with a READ-ONLY key) ───────────────
# Permissions: Query Funds + Query Open/Closed Orders ONLY.
# NEVER enable Withdraw Funds on this key.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_TIER=starter

# ── Alpaca (legacy / fallback) ─────────────────────────────
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ── SAFETY LOCKS — do not change without reading SAFETY.md ─
PAPER_TRADING=true
ALLOW_LIVE_TRADING=false
DRY_RUN=true
LIVE_RISK_ACKNOWLEDGEMENT=

# ── Market ─────────────────────────────────────────────────
SYMBOL=BTC/USD
TIMEFRAME_MINUTES=15
LOOKBACK_BARS=500
MONITOR_INTERVAL_SECONDS=900
CANDLE_CLOSE_DELAY_SECONDS=2
AUTO_START_MONITOR=false

# ── Risk ───────────────────────────────────────────────────
STRATEGY_EQUITY_USD=25
RISK_PER_TRADE=0.01
MAX_POSITION_FRACTION=0.25
MAX_DAILY_LOSS_FRACTION=0.03
MAX_DRAWDOWN_FRACTION=0.10
MAX_ORDERS_PER_DAY=3
COOLDOWN_MINUTES=15
MIN_ORDER_NOTIONAL_USD=1.00

# ── Rapid mode ────────────────────────────────────────────
# Status-only flag selecting the fast 15m cadence above. Does NOT loosen the
# RSI/momentum strategy gates or any risk/loss/exposure threshold.
RAPID_MODE=true

# ── Data freshness (blocks trading on stale feeds) ─────────
# Newest bar may be at most TIMEFRAME_MINUTES x MAX_BAR_AGE_MULTIPLE old.
MAX_BAR_AGE_MULTIPLE=3.0
MAX_CLOCK_SKEW_SECONDS=30

# ── Market quality gates ───────────────────────────────────
MAX_SPREAD_BPS=50
MIN_DOLLAR_VOLUME=1000000

# ── Transport ──────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=15
MAX_RETRIES=3

# ── Strategy ───────────────────────────────────────────────
FAST_EMA=20
SLOW_EMA=50
REGIME_EMA=200
RSI_PERIOD=14
RSI_MIN=45
RSI_MAX=68
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=1.5
BREAKOUT_LOOKBACK=20
VOLUME_LOOKBACK=20
MIN_VOLUME_RATIO=1.10

# ── State paths (git-ignored, no secrets) ──────────────────
JOURNAL_PATH=logs/decisions.jsonl
EXECUTION_DB_PATH=logs/executions.sqlite3
AUDIT_LOG_PATH=logs/audit.jsonl
IDEMPOTENCY_PATH=logs/orders.json
NONCE_STATE_PATH=logs/nonce.json
# Kraken execution is permanently spot-only. Margin/leverage parameters are stripped.
MARGIN_ENABLED=false
