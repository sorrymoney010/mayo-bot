# ── Broker selection ───────────────────────────────────────
BROKER=kraken

# ── Kraken Spot (start with a READ-ONLY key) ───────────────
# Permissions: Query Funds + Query Open/Closed Orders ONLY.
# NEVER enable Withdraw Funds on this key.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_TIER=starter

# ── Alpaca (legacy / fallback) ─────────────────────────────
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ── SAFETY LOCKS — do not change without reading SAFETY.md ─
PAPER_TRADING=true
ALLOW_LIVE_TRADING=false
DRY_RUN=true
LIVE_RISK_ACKNOWLEDGEMENT=

# ── Market ─────────────────────────────────────────────────
SYMBOL=BTC/USD
TIMEFRAME_MINUTES=15
LOOKBACK_BARS=500
MONITOR_INTERVAL_SECONDS=900
CANDLE_CLOSE_DELAY_SECONDS=2
AUTO_START_MONITOR=false

# ── Risk ───────────────────────────────────────────────────
STRATEGY_EQUITY_USD=25
RISK_PER_TRADE=0.01
MAX_POSITION_FRACTION=0.25
MAX_DAILY_LOSS_FRACTION=0.03
MAX_DRAWDOWN_FRACTION=0.10
MAX_ORDERS_PER_DAY=3
COOLDOWN_MINUTES=15
MIN_ORDER_NOTIONAL_USD=1.00

# ── Rapid mode ────────────────────────────────────────────
# Status-only flag selecting the fast 15m cadence above. Does NOT loosen the
# RSI/momentum strategy gates or any risk/loss/exposure threshold.
RAPID_MODE=true

# ── Data freshness (blocks trading on stale feeds) ─────────
# Newest bar may be at most TIMEFRAME_MINUTES x MAX_BAR_AGE_MULTIPLE old.
MAX_BAR_AGE_MULTIPLE=3.0
MAX_CLOCK_SKEW_SECONDS=30

# ── Market quality gates ───────────────────────────────────
MAX_SPREAD_BPS=50
MIN_DOLLAR_VOLUME=1000000

# ── Transport ──────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=15
MAX_RETRIES=3


# ── Strategy selection ─────────────────────────────────────
# momentum (default): RSI band + HARD regime EMA gate (no counter-trend BUYs)
# mean_reversion: oversold stretch reversion
# sr_flip: resistance→support flip reclaim
# pattern / elliott_lite: double-bottom neckline / bullish flag breakout
# breakout / momentum_breakout: N-bar high + volume > avg (defined-risk 2%/4%)
STRATEGY=momentum
# ── Momentum breakout sleeve (STRATEGY=breakout) ───────────
# Universe (canonical Kraken form; gateway maps BTC/USD → XXBTZUSD etc.)
BREAKOUT_SYMBOLS=["BTC/USD","ETH/USD","SOL/USD"]
BREAKOUT_LOOKBACK=20
BREAKOUT_VOL_AVG=20
# Risk: ~1% equity / trade; stop 2% below entry; TP 4% (2R)
# Aliases: RISK_PCT, STOP_PCT also accepted.
RISK_PER_TRADE=0.01
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
MAX_CONCURRENT_POSITIONS=3
# Prefer basket mode + allowlist matching BREAKOUT_SYMBOLS for this sleeve.
# UNIVERSE_MODE=basket
# UNIVERSE_ALLOWLIST=["BTC/USD","ETH/USD","SOL/USD"]
# COIN_BASKET=["BTC/USD","ETH/USD","SOL/USD"]
# TIMEFRAME_MINUTES=15
# ADX sit-out is soft-disabled for breakout (engine applies ADX only to momentum).
# Fee min-edge still applies; 4% TP clears MIN_EDGE_BPS=100.
# S/R flip knobs (used when STRATEGY=sr_flip)
SR_LOOKBACK=120
SR_PIVOT_STRENGTH=3
SR_MIN_BREAK_ATR=0.25
SR_MIN_BREAK_PCT=0.002
# Pattern / elliott_lite knobs
PATTERN_PIVOT_STRENGTH=2
PATTERN_DBL_TOL_PCT=0.02
PATTERN_MIN_BREAK_PCT=0.001
PATTERN_FLAG_POLE_PCT=0.03
PATTERN_FLAG_BARS=6
# ── Strategy ───────────────────────────────────────────────
FAST_EMA=20
SLOW_EMA=50
REGIME_EMA=200
RSI_PERIOD=14
RSI_MIN=45
RSI_MAX=68
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=1.5
BREAKOUT_LOOKBACK=20
VOLUME_LOOKBACK=20
MIN_VOLUME_RATIO=1.10

# ── ADX regime sit-out (momentum) ──────────────────────────
# Trade momentum only when ADX shows a trend. HARD BUY gate:
#   ADX > ADX_ENTER_ABOVE (~25) → allow entries
#   ADX < ADX_EXIT_BELOW  (~20) → sit out (chop)
#   between bands → hysteresis (keep prior allow/deny)
# Tune: raise ENTER_ABOVE to be pickier; lower EXIT_BELOW to stay in
# trend longer once admitted. Disable with ADX_GATE_ENABLED=false.
ADX_PERIOD=14
ADX_ENTER_ABOVE=25
ADX_EXIT_BELOW=20
ADX_GATE_ENABLED=true

# ── Fee-aware minimum edge ─────────────────────────────────
# Kraken retail Tier 1 ≈ 40 bps maker / 80 bps taker (RT taker ≈ 160 bps).
# Block new BUYs whose take-profit / expected move is below this floor
# (100–150 bps recommended) so fee bleed cannot dominate. Units: basis points.
# Example: MIN_EDGE_BPS=100 → TP must be ≥ 1.0% before fees.
MIN_EDGE_BPS=100
MIN_EDGE_GATE_ENABLED=true

# ── State paths (git-ignored, no secrets) ──────────────────
JOURNAL_PATH=logs/decisions.jsonl
EXECUTION_DB_PATH=logs/executions.sqlite3
AUDIT_LOG_PATH=logs/audit.jsonl
IDEMPOTENCY_PATH=logs/orders.json
NONCE_STATE_PATH=logs/nonce.json
# Kraken execution is permanently spot-only. Margin/leverage parameters are stripped.
MARGIN_ENABLED=false

# ── Regime-switch trend sleeve + adaptive learner (paper) ──────────────
# STRATEGY=regime_trend  TIMEFRAME_MINUTES=60  STOP_LOSS_PCT=0.03  TAKE_PROFIT_PCT=0.25
REGIME_LOOKBACK=20
REGIME_ATR_MULT=3.0
REGIME_MIN_ATR_RANK=0.0
LEARNER_GATE_ENABLED=true
LEARNER_MIN_SAMPLE=8
LEARNER_BENCH_HOURS=72
LEARNER_PRIORS_PATH=data/walkforward_results.json
# Paper sizing from the paper ledger ($STRATEGY_EQUITY_USD book) instead of the real balance
PAPER_USE_LEDGER_EQUITY=false
