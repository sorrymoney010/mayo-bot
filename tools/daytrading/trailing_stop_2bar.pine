//@version=5
strategy("2-Bar Trailing Stop (demo: MA cross entry)", overlay=true, initial_capital=25000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100, calc_on_every_tick=false)

// Long-only. Entry demo = fast SMA crosses above slow SMA (swap in your own entry).
// Initial stop = lowest low of the N bars BEFORE the entry bar.
// Trail: when the bar makes a new N-bar high, stop := max(stop, lowest low of the last N bars).
// The stop only ever moves up. Exit via strategy.exit() when the stop is hit.

enabled  = input.bool(true, "Strategy enabled")
n        = input.int(2, "Lookback bars", minval=1)
fastLen  = input.int(10, "Fast SMA", minval=1)
slowLen  = input.int(30, "Slow SMA", minval=2)
showStop = input.bool(true, "Show stop line")

var float stopPx  = na
var bool  trailed = false

longSignal = ta.crossover(ta.sma(close, fastLen), ta.sma(close, slowLen))

if enabled and longSignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

justEntered = strategy.position_size > 0 and strategy.position_size[1] <= 0
justExited  = strategy.position_size[1] > 0 and strategy.position_size <= 0

if justEntered
    stopPx := ta.lowest(low, n)[1]          // N bars before the entry bar
    trailed := false

if strategy.position_size > 0 and not justEntered
    newHigh = high > ta.highest(high, n)[1]  // new N-bar high vs the previous N bars
    if newHigh
        candidate = ta.lowest(low, n)        // lowest low of the last N bars (incl. this one)
        if candidate > stopPx
            stopPx := candidate
            trailed := true

if strategy.position_size > 0 and not na(stopPx)
    strategy.exit("Stop", "Long", stop=stopPx)

if justExited
    stopPx := na
    trailed := false

plot(showStop and strategy.position_size > 0 ? stopPx : na, "Stop", color=trailed ? color.green : color.red,
     linewidth=2, style=plot.style_linebr)
plotshape(justEntered, "Entry", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(justExited, "Exit", shape.square, location.abovebar, color.red, size=size.tiny)
