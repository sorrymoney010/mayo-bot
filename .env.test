# Paper trading / live trading switch
paper_trading=True
allow_live_trading=false
dry_run=true

# Risk settings - 2% per trade, 5% max daily loss (aggressive for rotation)
risk_per_trade=0.02
max_daily_loss_fraction=0.05
max_drawdown_fraction=0.15

# One-hour regime-trend research cadence
timeframe_minutes=60
monitor_interval_seconds=60
cooldown_minutes=2

# BTC/ETH/SOL regular spot universe
universe_allowlist=["BTC/USD","ETH/USD","SOL/USD"]
coin_basket=["BTC/USD","ETH/USD","SOL/USD"]

# Strategy equity for paper trading
strategy_equity_usd=100.0

# Legacy test-only order type; execution locks remain on
order_type=market
