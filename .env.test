# Paper trading / live trading switch
paper_trading=True
allow_live_trading=false
dry_run=false

# Risk settings - 2% per trade, 5% max daily loss (aggressive for rotation)
risk_per_trade=0.02
max_daily_loss_fraction=0.05
max_drawdown_fraction=0.15

# Faster cadence for rotation strategy
timeframe_minutes=15
monitor_interval_seconds=60
cooldown_minutes=2

# Universe: add XRP for rotation
universe_allowlist=["BTC/USD","PUMP/USD","XRP/USD"]
coin_basket=["BTC/USD","PUMP/USD","XRP/USD"]

# Strategy equity for paper trading
strategy_equity_usd=100.0

# Order type: market for faster execution in rotation
order_type=market
